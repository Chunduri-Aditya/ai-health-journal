# Journal Agent — configuration template.
# Copied to .env on first run of ./start.sh. Edit .env freely; it is gitignored.

# ── Model selection ──────────────────────────────────────────────
# "balanced" auto-picks a stack based on machine RAM and installed Ollama models.
MODEL_SELECTION_STRATEGY=balanced
MODEL_MACHINE_TIER_OVERRIDE=auto

# Optional explicit overrides (uncomment to force specific models):
# GENERATOR_MODEL=qwen3:8b
# FALLBACK_MODEL=qwen3:8b
# VERIFIER_MODEL=qwen3:8b
# PROMPT_MODEL=gemma3:4b

# ── Feature flags ────────────────────────────────────────────────
QUALITY_MODE_DEFAULT=true
# Block coding/Q&A before spending Draft→Verify→Revise tokens (JOURNAL_RELEVANCE_GATE=true)
# JOURNAL_RELEVANCE_GATE=true
RETRIEVAL_ENABLED=true
GROUNDEDNESS_THRESHOLD=0.75

# ── Retrieval backend (only used when RETRIEVAL_ENABLED=true) ────
# none / chroma / pinecone
# chroma (local, default) ships in the core install; no extra step.
# First query downloads the default MiniLM embedder (~80MB) from HuggingFace;
# after that it runs fully offline from ./storage/chroma.
VECTOR_BACKEND=chroma
ALLOW_CLOUD_VECTORSTORE=false
# CHROMA_PERSIST_DIR=./storage/chroma

# ── Namespace isolation (see docs/upgrades/01-retrieval-grounding.md) ─
# session / user / fixed
RAG_NAMESPACE_MODE=fixed
RAG_NAMESPACE_FIXED=ai-health-journal

# ── Privacy ──────────────────────────────────────────────────────
PRIVACY_MODE=balanced
LOCAL_CACHE_MAX_ITEMS=2000

# ── Voice transcription (requires openai-whisper) ────────────────
WHISPER_MODEL=base
WHISPER_MAX_AUDIO_BYTES=15728640

# ── Web session ──────────────────────────────────────────────────
# SECRET_KEY is regenerated every boot unless you pin it here.
# SECRET_KEY=change-me-to-a-long-random-string

# ── Local embedding backend ──────────────────────────────────────
# default = Chroma's bundled MiniLM (384-dim, zero setup).
# ollama  = a local Ollama embedding model. Requires: ollama pull nomic-embed-text
#           Measured better or equal in every retrieval trap category on both
#           eval corpora (docs/IMPROVEMENTS.md §10).
# Switching this against an existing store requires re-embedding first:
#   python scripts/migrate_embeddings.py            # preview
#   python scripts/migrate_embeddings.py --apply    # migrate
EMBEDDING_BACKEND=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_URL=http://localhost:11434

# ── Reference corpus (OpenStax Psychology 2e, CC BY-NC-SA 4.0) ────
# Off by default: retrieval only grounds reflections in journal history unless
# you opt in here. Requires RETRIEVAL_ENABLED=true (shares the same Chroma
# store) and the corpus to be ingested first:
#   python scripts/ingest_reference_corpus.py
# The ingested text and its embeddings are never committed (see .gitignore);
# every citation shown to the user carries OpenStax's required attribution
# line. See docs/CLINICAL_DESIGN.md for the license and citation requirements.
REFERENCE_CORPUS_ENABLED=false
REFERENCE_TOP_K=2
# REFERENCE_NAMESPACE=reference:psychology


# ── Journal Agent / pgvector (deployed service) ──────────────────
# none / chroma / pgvector / pinecone
# VECTOR_BACKEND=pgvector
# DATABASE_URL=postgresql://journal:journal@localhost:5432/journal
# ALLOW_CLOUD_VECTORSTORE=false
# CHUNK_SIZE=400
# CHUNK_OVERLAP=80
# HNSW_M=16
# HNSW_EF_CONSTRUCTION=64
# HNSW_EF_SEARCH=40
# EMBEDDING_BACKEND=hash
# EMBEDDING_DIMENSION=384
# OPENAI_EMBED_MODEL=text-embedding-3-small
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# AGENT_CONFIRM_WRITES=true

# Observability (service)
# LANGFUSE_ENABLED=false
# TRACE_INCLUDE_TEXT=false  # keep journal bodies out of Langfuse unless explicitly enabled

# ── Cloud LLM (gated; off by default) ────────────────────────────
# LLM_BACKEND=ollama | anthropic | openai_compatible
LLM_BACKEND=ollama
ALLOW_CLOUD_LLM=false
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_GENERATOR_MODEL=claude-sonnet-4-6
# ANTHROPIC_VERIFIER_MODEL=claude-sonnet-4-6
# ANTHROPIC_PROMPT_MODEL=claude-haiku-4-5-20251001
#
# Free OSS chat via Groq (or any OpenAI-compatible host):
# LLM_BACKEND=openai_compatible
# ALLOW_CLOUD_LLM=true
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=gsk-...
# Multi-model free-tier stack under Groq ~8K TPM / model:
#   generator = draft (20B — most calls)
#   fallback  = revise (120B — only when rewrite needed)
#   verifier/prompt = 20B JSON/tool path
# GateGuard: callers start.sh/docs. Affected API: example Groq role models.
# Data schemas: none. User: Groq org limits table.
# OPENAI_COMPATIBLE_GENERATOR_MODEL=openai/gpt-oss-20b
# OPENAI_COMPATIBLE_FALLBACK_MODEL=openai/gpt-oss-120b
# OPENAI_COMPATIBLE_VERIFIER_MODEL=openai/gpt-oss-20b
# OPENAI_COMPATIBLE_PROMPT_MODEL=openai/gpt-oss-20b
# If still rate-limited: set FALLBACK to openai/gpt-oss-20b or qwen/qwen3.6-27b
# OpenRouter alternative: OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1

# ── FastAPI service auth (required outside ENV=dev/test) ──────────
# ENV=dev
# JOURNAL_AGENT_API_KEY=  # required when ENV is production; send as X-API-Key
# See docs/DEPLOY.md for Fly + Neon + Groq/Anthropic setup.

